__pycache__/
*.pyc
.phase0-data/
reviews/

# Local data cruft — the REAL store lives in the sibling research-system-rag-data/ dir.
# A relative-path run can create empty/partial copies of these at the repo root (OG-33) — the
# empty papers.db is the exact file build_mcp_server used to fall back to (the fake Recall@10=0.000
# trap, fixed in T-DOC56). Never track them here.
papers.db
papers.db-shm
papers.db-wal
pdf_cache/
blobs/

# Waymo AV-safety corpus (docs/superpowers/plans/2026-08-05-waymo-corpus-expansion.md) — an
# isolated second corpus's data dir, living outside any worktree (main checkout), never
# committed, same reason the main corpus's data files aren't tracked either.
/waymo/

# The operator's manually-curated PDF library staged for `app.ingest_local` (1.8G, 457 PDFs as of
# 2026-08-18). Source material, not source code -- and large enough that an unguarded `git add -A`
# would be a genuinely painful mistake. `waymo/data/drop_in/` is already covered by /waymo/ above;
# this covers the repo-root tray.
/drop_in/

# Stray test-run log leftovers at repo root — not source, never intentionally tracked.
test*.log

# The real, operator-specific config (T-DOC89 §2): the tracked template is config.example.yaml.
# A real config.yaml (repo-root symlink or copy) must never be committed -- it names real,
# machine-specific absolute paths.
config.yaml

# Agent worktrees / local Claude state — never track.
.claude/
.worktrees/
.gpu.lock

# Graphify knowledge-graph output — a local, regenerated artifact (4MB+ graph.json + HTML,
# rebuilt free by the post-commit hook / `graphify update .`). The `.graphifyignore` corpus
# filter IS tracked; the generated graph is not. Flip this line off to version the graph across
# worktrees (a union merge-driver is already registered in .gitattributes for that case).
graphify-out/
